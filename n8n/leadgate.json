      "typeVersion": 4.2,
      "position": [480, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "leadgateSecret0001",
          "name": "leadgate webhook secret"
        }
      },
      "notes": "Answers {run_id, campaign_id, status}. The run waits for a human in leadgate's approval queue."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "leadgate-results",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "6f0c1d52-8a0e-4a51-9d41-3f2f1b8e0a05",
      "name": "Run results from leadgate",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 420],
      "webhookId": "2b7c9a4e-5d3f-4e8a-9c1b-6a0d4e2f7b15",
      "credentials": {
        "httpHeaderAuth": {
          "id": "leadgateSecret0001",
          "name": "leadgate webhook secret"
        }
      },
      "notes": "leadgate posts each finished run here (same X-Webhook-Secret header)."
    },
    {
      "parameters": {
        "jsCode": "// One line per finished run: how many leads went where.\nconst run = $input.first().json.body;\nconst count = (route) => run.leads.filter((lead) => lead.route === route).length;\nreturn [{\n  json: {\n    run_id: run.run_id,\n    status: run.status,\n    leads: run.leads.length,\n    approved: count('notify'),\n    escalated: count('escalate'),\n    rejected: count('skip'),\n    in_crm: run.leads.filter((lead) => lead.crm_record_id).map((lead) => lead.name),\n  },\n}];\n"
      },
      "id": "6f0c1d52-8a0e-4a51-9d41-3f2f1b8e0a06",
      "name": "Summarize the run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 420]
    }
