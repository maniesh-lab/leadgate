# Copy to .env and fill in. Never commit .env.

# Postgres container user (compose falls back to "leadgate" if empty)
POSTGRES_USER=
# Postgres container password (compose falls back to "leadgate" if empty)
POSTGRES_PASSWORD=
# Postgres database name (compose falls back to "leadgate" if empty)
POSTGRES_DB=
# How many daily database dumps the `backup` service keeps in ./backups; empty = 7
BACKUP_KEEP=

# SQLAlchemy URL for running the API outside Docker, e.g. postgresql+psycopg://leadgate:leadgate@localhost:5432/leadgate
DATABASE_URL=

# Email of the first admin user, created by `python -m app.cli seed`; also the default reviewer of `python -m app.cli decide`
ADMIN_EMAIL=
# Password of the first admin user (stored only as an Argon2 hash)
ADMIN_PASSWORD=

# Public demo only: the reviewer login shown on the login page, made by `python -m app.cli demo`; its password can't be changed and failed logins don't lock it. Empty = no demo login
DEMO_REVIEWER_EMAIL=
# Public demo only: that reviewer's password (shown to every visitor, so never reuse a real one)
DEMO_REVIEWER_PASSWORD=

# Signs the API's login tokens; required by the API, 32+ characters (make one with: openssl rand -hex 32)
JWT_SECRET=
# Minutes a login token stays valid (no refresh tokens); empty = 60
JWT_EXPIRE_MINUTES=
# true = an admin must turn on two-factor login (Account page) before the admin tools work; set it once leadgate is reachable from the internet; empty = false
REQUIRE_ADMIN_TWO_FACTOR=

# User-Agent for every outside request: lead sources + website crawler (OSM's policy wants one that names the app); empty = leadgate's default
OSM_USER_AGENT=
# OpenStreetMap's place lookup (Nominatim search URL); empty = https://nominatim.openstreetmap.org/search
NOMINATIM_URL=
# OpenStreetMap's business search (Overpass interpreter URL); empty = https://overpass-api.de/api/interpreter
OVERPASS_URL=
# A second Overpass server, asked when the first is busy or can't be reached; empty = none. Free public ones (OSM wiki, 2026-11-08): https://overpass.private.coffee/api/interpreter, https://maps.mail.ru/osm/tools/overpass/api/interpreter
OVERPASS_BACKUP_URL=
# Google Places API (New) key; empty = the google_places source is skipped and OSM is used
GOOGLE_PLACES_API_KEY=

# Days a lead's website enrichment is reused before the site is crawled again; empty = 14
ENRICH_CACHE_DAYS=
# Max pages fetched per website (home + contact/about/team/services pages); empty = 4
ENRICH_MAX_PAGES=

# true on the public demo only: no outside calls, no new campaigns or runs (needs LLM_MODE=fake and no Google/Airtable/Discord/Langfuse keys); empty = off
PUBLIC_DEMO=

# Biggest CSV an admin can upload in the dashboard, in bytes; empty = 1000000 (1 MB, ~5,000-10,000 leads); the bundled nginx lets at most 10 MB through
CSV_UPLOAD_MAX_BYTES=

# LLM for the agents: fake (no network; tests/CI/offline demos), groq, openai or anthropic (Claude); empty = fake
LLM_MODE=
# Model name; empty = openai/gpt-oss-20b on groq, gpt-4o-mini on openai, claude-haiku-5-5 on anthropic (e.g. claude-sonnet-5-5 or claude-opus-5-5 for a stronger, dearer model)
LLM_MODEL=
# How long the model thinks before answering: low, medium or high; empty = low (fits Groq's free tier). On groq it's gpt-oss's reasoning (medium finds a business's services better but uses about twice the tokens, and the token limit grows with it); on anthropic it's Claude's effort level
LLM_REASONING_EFFORT=
# Tokens the agents may use per minute; a call that would go over waits instead of failing with a rate-limit error. empty = 8000 on groq (the free tier's limit for gpt-oss-20b, used for any groq model; set it for a model or plan with another limit), no limit on openai or anthropic
LLM_TOKENS_PER_MINUTE=
# Groq API key (free at console.groq.com); needed when LLM_MODE=groq
GROQ_API_KEY=
# OpenAI API key; needed when LLM_MODE=openai
OPENAI_API_KEY=
# Anthropic API key (console.anthropic.com, paid); needed when LLM_MODE=anthropic
ANTHROPIC_API_KEY=

# true = run the job worker inside the API process (one process for free hosting); empty = false (use the worker service)
RUN_WORKER_IN_API=

# Airtable personal access token (scopes data.records:read + write, on this base only); all three AIRTABLE_* set = approved leads go to Airtable, else they're kept in memory
AIRTABLE_TOKEN=
# Airtable base id (starts with "app"; only the id, not the whole URL)
AIRTABLE_BASE_ID=
# Airtable table name or id (the table needs the fields listed in backend/app/services/crm.py)
AIRTABLE_TABLE=

# Discord webhook URL of the leads channel (approved leads); empty = messages are only logged
DISCORD_WEBHOOK_URL=
# Discord webhook URL of the admin channel (escalations); empty = escalations go to the leads channel
DISCORD_ADMIN_WEBHOOK_URL=

# Shared secret with Switchyard's n8n (X-Webhook-Secret header, both ways), 32+ characters (make one with: openssl rand -hex 32); empty = the n8n webhook is off
N8N_WEBHOOK_SECRET=

# Langfuse public key (cloud.langfuse.com → project settings → API keys); both keys set = each run item is traced
LANGFUSE_PUBLIC_KEY=
# Langfuse secret key
LANGFUSE_SECRET_KEY=
# Langfuse server (the SDK's name; LANGFUSE_HOST is the old one); empty = https://cloud.langfuse.com (use https://us.cloud.langfuse.com for the US region)
LANGFUSE_BASE_URL=

# Websites allowed to call the API from a browser (CORS), comma-separated, e.g. https://leadgate.example.com; empty = none (the dashboard is served from the same address as the API)
CORS_ORIGINS=

# The API's address as the dashboard sees it, e.g. https://api.leadgate.example.com; empty = the same address as the dashboard (Vite's dev server passes /api to localhost:8000)
VITE_API_URL=
# Public demo only: the login page shows this reviewer login with a "Use the demo login" button (build time; the same values as DEMO_REVIEWER_*); empty = no demo login shown
VITE_DEMO_EMAIL=
# Public demo only: the demo reviewer's password, built into the page (it's public)
VITE_DEMO_PASSWORD=
