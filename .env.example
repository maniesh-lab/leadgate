# Copy to .env and fill in. Never commit .env.

# Postgres container user, password and database name (compose falls back to "leadgate" if empty)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# SQLAlchemy URL for running the API outside Docker, e.g. postgresql+psycopg://leadgate:leadgate@localhost:5432/leadgate
DATABASE_URL=
