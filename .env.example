# Copy to .env and fill in. Never commit .env.

# Postgres container user (compose falls back to "leadgate" if empty)
POSTGRES_USER=
# Postgres container password (compose falls back to "leadgate" if empty)
POSTGRES_PASSWORD=
# Postgres database name (compose falls back to "leadgate" if empty)
POSTGRES_DB=

# SQLAlchemy URL for running the API outside Docker, e.g. postgresql+psycopg://leadgate:leadgate@localhost:5432/leadgate
DATABASE_URL=

# Email of the first admin user, created by `python -m app.cli seed`; also the default reviewer of `python -m app.cli decide`
ADMIN_EMAIL=
# Password of the first admin user (stored only as an Argon2 hash)
ADMIN_PASSWORD=

# Signs the API's login tokens; required by the API, 32+ characters (make one with: openssl rand -hex 32)
JWT_SECRET=
# Minutes a login token stays valid (no refresh tokens); empty = 60
JWT_EXPIRE_MINUTES=

# User-Agent for every outside request: lead sources + website crawler (OSM's policy wants one that names the app); empty = leadgate's default
OSM_USER_AGENT=
# Google Places API (New) key; empty = the google_places source is skipped and OSM is used
GOOGLE_PLACES_API_KEY=

# Days a lead's website enrichment is reused before the site is crawled again; empty = 14
ENRICH_CACHE_DAYS=
# Max pages fetched per website (home + contact/about/team/services pages); empty = 4
ENRICH_MAX_PAGES=

# LLM for the agents: fake (no network; tests/CI/offline demos), groq or openai; empty = fake
LLM_MODE=
# Model name for groq/openai; empty = openai/gpt-oss-20b on groq, gpt-4o-mini on openai
LLM_MODEL=
# Groq API key (free at console.groq.com); needed when LLM_MODE=groq
GROQ_API_KEY=
# OpenAI API key; needed when LLM_MODE=openai (also: pip install -e ".[openai]"; not in the Docker image)
OPENAI_API_KEY=

# true = run the job worker inside the API process (one process for free hosting); empty = false (use the worker service)
RUN_WORKER_IN_API=

# Airtable personal access token (scopes data.records:read + write, on this base only); all three AIRTABLE_* set = approved leads go to Airtable, else they're kept in memory
AIRTABLE_TOKEN=
# Airtable base id (starts with "app"; only the id, not the whole URL)
AIRTABLE_BASE_ID=
# Airtable table name or id (the table needs the fields listed in backend/app/services/crm.py)
AIRTABLE_TABLE=

# Discord webhook URL of the leads channel (approved leads); empty = messages are only logged
DISCORD_WEBHOOK_URL=
# Discord webhook URL of the admin channel (escalations); empty = escalations go to the leads channel
DISCORD_ADMIN_WEBHOOK_URL=

# Shared secret with Switchyard's n8n (X-Webhook-Secret header, both ways), 32+ characters (make one with: openssl rand -hex 32); empty = the n8n webhook is off
N8N_WEBHOOK_SECRET=
